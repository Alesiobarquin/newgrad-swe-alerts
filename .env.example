SCRAPER_PROVIDER=instagram_downloader
TARGET_IG_USERNAME=zero2sudo
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-downloader-download-instagram-stories-videos4.p.rapidapi.com
# The Instagram Downloader adapter uses GET /convert directly; the generic
# RapidAPI method/template/path fields below are ignored for this provider.
RAPIDAPI_METHOD=GET
RAPIDAPI_URL_TEMPLATE=https://{host}/convert
RAPIDAPI_BODY_TEMPLATE=
RAPIDAPI_ITEMS_PATH=media
RAPIDAPI_USER_ID_URL_TEMPLATE=https://{host}/user_id_by_username?username={username}
TARGET_IG_USER_ID=
APIFY_API_TOKEN=
APIFY_STANDBY_URL=
APIFY_STANDBY_METHOD=POST
UPSTASH_REDIS_URL=rediss://default:token@host:port
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=13
NOTIFY_PROVIDER=ntfy
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
OVERRIDE_COMPANIES=Google,Meta,Stripe,Jane Street,Citadel,OpenAI,Nvidia,Apple,Amazon,Microsoft,Netflix
QUIET_HOURS_START_HOUR=23
QUIET_HOURS_END_HOUR=8
TIMEZONE=America/New_York
# Production cadence for Instagram Downloader Pro (3,200 requests/day).
# Basic (45 requests/month) is only suitable for manual compatibility tests.
ACTIVE_POLL_INTERVAL_SECONDS=60
QUIET_POLL_INTERVAL_SECONDS=3600
CLAIM_TTL_SECONDS=180
STORY_TTL_SECONDS=172800
LOG_LEVEL=INFO
